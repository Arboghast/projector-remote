# Copy to .env on the server.

# The projector's adb address (Settings > network debugging on the projector).
PROJECTOR_ADB=192.168.1.5:5555

# Spoken requests run Claude Code in the container. Sign it in once with
# `docker compose exec remote claude`, or paste a token from `claude setup-token` here.
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional Tailscale entry point: uncomment, run ./deploy.sh, then open the login link
# printed by: docker compose logs tailscale
# COMPOSE_PROFILES=tailscale
