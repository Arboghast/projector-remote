{
  "manifest_version": 3,
  "name": "Send to Projector",
  "version": "1.1.0",
  "description": "Saves the page or link to the projector remote's Shelf.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Send to Projector",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://192.168.1.13/*",
    "https://*.ts.net/*"
  ]
}